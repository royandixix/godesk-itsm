APP_NAME=GoDesk
APP_ENV=development
APP_PORT=8082

DATABASE_URL=postgres://godesk_user:YOUR_DATABASE_PASSWORD@localhost:5434/godesk?sslmode=disable

FRONTEND_URL=http://localhost:3000

JWT_SECRET=YOUR_RANDOM_SECRET_MINIMUM_32_CHARACTERS
JWT_ISSUER=godesk-api
JWT_TTL_HOURS=12
COOKIE_NAME=godesk_token

BOOTSTRAP_ADMIN_NAME=GoDesk Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD